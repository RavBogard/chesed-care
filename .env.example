# CRC Care environment. Copy to .env.local for local work; set the same names in Vercel.
# Never commit real values.

# --- Database (Neon Postgres) ---
# Pooled connection string the app uses at runtime.
DATABASE_URL=
# Optional: a direct (non-pooled) connection used only by `npm run db:migrate`.
# Falls back to DATABASE_URL when blank. The build never runs migrations.
DATABASE_MIGRATION_URL=

# --- Sign-in (better-auth + Google) ---
# The app's public origin, e.g. https://care.centralreform.org (no path, no trailing slash).
BETTER_AUTH_URL=
# Random secret of at least 32 characters (e.g. `openssl rand -base64 48`).
BETTER_AUTH_SECRET=
# Google OAuth web client. Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated owner emails. Owners are let in and recognised automatically;
# everyone else must be added to the users table by an owner.
OWNER_EMAILS=

# --- Salesforce (read-only; same variables as MavenAI's service account) ---
# Connected-app consumer key for the JWT bearer flow.
SF_JWT_CONSUMER_KEY=
# The Salesforce username the app runs as.
SF_JWT_USERNAME=
# The connected app's private key: PEM, or the PEM base64-encoded.
SF_JWT_PRIVATE_KEY=
# Optional: login host (default https://login.salesforce.com).
SF_JWT_AUDIENCE=
# Optional: instance URL used when the token response has none (e.g. https://yourorg.my.salesforce.com).
SF_SERVICE_INSTANCE_URL=

# --- Health check ---
# Optional secret. /api/health pings the database only when the request sends this
# value in the x-health-token header (uptime monitor); otherwise the database is
# never touched, so anonymous callers cannot keep it awake. Blank = never pinged.
HEALTH_TOKEN=

# --- Daily job ---
# Secret the scheduled request must send (Vercel Cron sets it as the bearer token).
CRON_SECRET=

# --- Email (Resend) ---
# Blank = no email is sent. Email is on only in production, or where CARE_EMAIL=on; CARE_EMAIL=off always wins.
RESEND_API_KEY=
CARE_EMAIL=
# Optional: where replies go (default care@centralreform.org).
CARE_REPLY_TO=

# --- AI reading of the Inbox ---
# Blank key = proposals are not read. On only in production, or where CARE_AI_SORTING=on; off always wins.
ANTHROPIC_API_KEY=
CARE_AI_SORTING=

# --- Phone notifications (web push) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact for the push services.
VAPID_SUBJECT=

# --- Mi Sheberach packet sync (Google Docs) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
# The document id, and the mode: off, dry-run (read only; the default) or on.
MISHEBERACH_DOC_ID=
MISHEBERACH_SYNC_MODE=

# --- Demo build (docs/DEMO.md) ---
# "on" makes this deployment the public demo: invented people, no sign-in, no Salesforce, no email.
# Set it ONLY on the separate demo project, with a database of its own. Leave it blank everywhere else.
NEXT_PUBLIC_CARE_DEMO=
# Optional, demo only: a short code visitors type once before they come in. Blank = anyone with the address.
DEMO_ACCESS_CODE=
